# Copy to .env and fill in the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides for configs/oxdna.yaml
# OXDNA_MODE=wsl|local|modal|mock
# OXDNA_EXECUTABLE=/usr/local/bin/oxDNA
# OXDNA_BACKEND=CUDA|CPU
# OXDNA_MODAL_GPU=T4
# Modal credentials: `uv run modal token new` stores them in ~/.modal.toml. For CI, set these instead:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
